# Copy to .env; generate fresh secrets with: python -c "import secrets; print(secrets.token_hex(32))"
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/logsentinel.db
SECRET_KEY=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
PUBLIC_ORIGIN=http://localhost:5173
# Docker Compose requires POSTGRES_PASSWORD and SECRET_KEY set to fresh secrets.
POSTGRES_PASSWORD=
# Optional reset delivery: configure a local SMTP relay; no external service required.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=logsentinel@localhost
SMTP_TLS=true
UPLOAD_MAX_BYTES=10485760
SESSION_HOURS=12
